[{"text": "昨天在现场看了", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "才发现自己首弹幕", "time_ms": 0, "mode": 1, "tags": {"other": 0.7}, "dominant": "other", "score": 0.7, "source": "llm-llm"}, {"text": "跟巴狗学的yes没绷住", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "魔丸护", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "我不敢看了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.6}, "dominant": "emotional_resonance", "score": 0.6, "source": "llm-llm"}, {"text": "开局就没绷住", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5, "humor": 0.3}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "笑死了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.8}, "dominant": "emotional_resonance", "score": 0.8, "source": "llm-llm"}, {"text": "队友脸色不对了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "information": 0.2}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "好抽", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.3}, "dominant": "emotional_resonance", "score": 0.3, "source": "llm-llm"}, {"text": "压AK八倍镜", "time_ms": 0, "mode": 1, "tags": {"information": 0.6}, "dominant": "information", "score": 0.6, "source": "llm-llm"}, {"text": "终于有节目了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "队友你的svd怎么射速这么快", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "information": 0.3}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "在现场不点举报？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "队友：老黑你这连狙声音怎么这么奇怪", "time_ms": 0, "mode": 1, "tags": {"humor": 0.6, "information": 0.2}, "dominant": "humor", "score": 0.6, "source": "llm-llm"}, {"text": ".", "time_ms": 0, "mode": 1, "tags": {"irrelevant_repetition": 0.9}, "dominant": "irrelevant_repetition", "score": 0.9, "source": "llm-llm"}, {"text": "8倍ak都整了，这你不带三级头", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "humor": 0.3}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "猛回头", "time_ms": 0, "mode": 1, "tags": {"other": 0.5}, "dominant": "other", "score": 0.5, "source": "llm-llm"}, {"text": "纯女电竞魔王护可还行", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "inflammatory": 0.2}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "！？致敬区？！", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.4}, "dominant": "emotional_resonance", "score": 0.4, "source": "llm-llm"}, {"text": "排到音響了", "time_ms": 0, "mode": 1, "tags": {"other": 0.5}, "dominant": "other", "score": 0.5, "source": "llm-llm"}, {"text": "再戴个机枪兵的自闭头，完美", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "information": 0.3}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "靠谱在哪，因为是黑哥们吗", "time_ms": 0, "mode": 1, "tags": {"inflammatory": 0.8, "attack": 0.4, "political": 0.2}, "dominant": "inflammatory", "score": 0.8, "source": "llm-llm"}, {"text": "优势在我！", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "还有达妮娅厨", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "不是迷弟吗，怎么变成扫乌鸦了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "other": 0.3}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "老黑有队友", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "初见端倪", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "emotional_resonance": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "ohyes", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "2pac，有品！", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "emotional_resonance": 0.3}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "还是牢玩家", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "humor": 0.2}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "这下听懂了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.3, "humor": 0.2}, "dominant": "emotional_resonance", "score": 0.3, "source": "llm-llm"}, {"text": "纯女电竞吗，这声音很纯女了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "inflammatory": 0.3}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "地震了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "emotional_resonance": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "咦？这不是薄纱巴神的神器吗，李怎么给撇了呢", "time_ms": 0, "mode": 1, "tags": {"information": 0.4, "humor": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "右边出来了", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "哦 yes", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "不是高玩护？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "other": 0.3}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "还有2pac", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "谁没笑？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "emotional_resonance": 0.3}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "乌鸦确实是魔王", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "emotional_resonance": 0.2}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "乌鸦市区忘", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "笑点解析:加州不养闲人", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "information": 0.4}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "我的队友已经去抢吃宿舍了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "纯女会不会因为电梯超载然后堵半小时", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "inflammatory": 0.3}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "堵电梯超载半小时的魔王护吗", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "回来吧刺激战场~", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "你是女的吗", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "在现场", "time_ms": 0, "mode": 1, "tags": {"other": 0.5}, "dominant": "other", "score": 0.5, "source": "llm-llm"}, {"text": "sks？", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "达尼娅？", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "不是，皮肤呢", "time_ms": 0, "mode": 1, "tags": {"information": 0.3}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "我说我是魔王护你们尔多隆吗！", "time_ms": 0, "mode": 1, "tags": {"conflict": 0.6, "attack": 0.3, "humor": 0.2}, "dominant": "conflict", "score": 0.6, "source": "llm-llm"}, {"text": "运你一枪头气不气？", "time_ms": 0, "mode": 1, "tags": {"conflict": 0.7, "attack": 0.2, "humor": 0.2}, "dominant": "conflict", "score": 0.7, "source": "llm-llm"}, {"text": "内阁大学士", "time_ms": 0, "mode": 1, "tags": {"other": 0.5}, "dominant": "other", "score": 0.5, "source": "llm-llm"}, {"text": "还有达妮娅", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "是佛州不养闲人，加州养的全是黑人", "time_ms": 0, "mode": 1, "tags": {"inflammatory": 0.9, "political": 0.5, "attack": 0.4}, "dominant": "inflammatory", "score": 0.9, "source": "llm-llm"}, {"text": "地震了吗？", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "emotional_resonance": 0.2}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "老玩家看到都哭了T﹏T", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.7}, "dominant": "emotional_resonance", "score": 0.7, "source": "llm-llm"}, {"text": "欧美打法", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "放生一些金蛋", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "information": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "这镜子没有2.5的那个镜子好", "time_ms": 0, "mode": 1, "tags": {"information": 0.6}, "dominant": "information", "score": 0.6, "source": "llm-llm"}, {"text": "不是你也是女的？", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "纯女说是", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "inflammatory": 0.3}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "男性和购物袋不友好？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "inflammatory": 0.3, "other": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "ak不是装不了8倍吗", "time_ms": 0, "mode": 1, "tags": {"information": 0.7}, "dominant": "information", "score": 0.7, "source": "llm-llm"}, {"text": "也？", "time_ms": 0, "mode": 1, "tags": {"irrelevant_repetition": 0.5, "other": 0.3}, "dominant": "irrelevant_repetition", "score": 0.5, "source": "llm-llm"}, {"text": "原来你是女的啊，之前没看出来", "time_ms": 0, "mode": 1, "tags": {"other": 0.6}, "dominant": "other", "score": 0.6, "source": "llm-llm"}, {"text": "不是定级为top级吗，不是魔王吧", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "conflict": 0.2}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "炸单魔王也是魔王", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "information": 0.2}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "五图，单四，猛攻！！！！！", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "emotional_resonance": 0.3}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "同款改法", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "我绝航还用过3/7", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "细节黑卤蛋，和平最常用的黑皮没绷住", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "humor": 0.3}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "2pac", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "神了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "别再八倍镜，给我发倍镜，化身钓鱼执法官", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "不敢看了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.6}, "dominant": "emotional_resonance", "score": 0.6, "source": "llm-llm"}, {"text": "我我我我去，直播区", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5, "humor": 0.2}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "这下老黑真有队友了", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "humor": 0.2}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "优势在我", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "魔王看见了，纯女在哪？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "inflammatory": 0.3}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "扫乌鸦更新了，真的假的", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "还是个雷神", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "humor": 0.2}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "2", "time_ms": 0, "mode": 1, "tags": {"irrelevant_repetition": 0.9}, "dominant": "irrelevant_repetition", "score": 0.9, "source": "llm-llm"}, {"text": "水桶大残队友快上", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "emotional_resonance": 0.2}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "可是他玩的真的好开心", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.4, "information": 0.2}, "dominant": "emotional_resonance", "score": 0.4, "source": "llm-llm"}, {"text": "鸦区用上蓝血包了", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "sr9也是狙", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "humor": 0.2}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "露娜：你把sr9捡回来不就有了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "information": 0.3}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "不会反弹电箭，是猛攻区。", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "红蛋sr9+八倍镜还不是狙吗？", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "这俩也玩上了", "time_ms": 0, "mode": 1, "tags": {"information": 0.3}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "这俩骗子弹也骗得挺开心", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "information": 0.2}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "旋转喷气，难道说？", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "information": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "谁没笑", "time_ms": 0, "mode": 1, "tags": {"humor": 0.5, "emotional_resonance": 0.3}, "dominant": "humor", "score": 0.5, "source": "llm-llm"}, {"text": "队友新生爱慕了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "information": 0.2}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "八倍ak不就是狙吗", "time_ms": 0, "mode": 1, "tags": {"information": 0.6, "humor": 0.2}, "dominant": "information", "score": 0.6, "source": "llm-llm"}, {"text": "四叶大残", "time_ms": 0, "mode": 1, "tags": {"information": 0.5}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "没带球", "time_ms": 0, "mode": 1, "tags": {"information": 0.4}, "dominant": "information", "score": 0.4, "source": "llm-llm"}, {"text": "还有大陀螺", "time_ms": 0, "mode": 1, "tags": {"information": 0.3, "humor": 0.3}, "dominant": "information", "score": 0.3, "source": "llm-llm"}, {"text": "哈哈哈哈哈", "time_ms": 0, "mode": 1, "tags": {"irrelevant_repetition": 0.95}, "dominant": "irrelevant_repetition", "score": 0.95, "source": "llm-llm"}, {"text": "这队友真修啊，拿甲修换节目来了（）", "time_ms": 0, "mode": 1, "tags": {"humor": 0.6, "information": 0.25}, "dominant": "humor", "score": 0.6, "source": "llm-llm"}, {"text": "谈笑间狙击兵坠机了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.55, "information": 0.35}, "dominant": "humor", "score": 0.55, "source": "llm-llm"}, {"text": "止痛药不是奶片差评", "time_ms": 0, "mode": 1, "tags": {"humor": 0.8, "information": 0.15}, "dominant": "humor", "score": 0.8, "source": "llm-llm"}, {"text": "脸色对了", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.5, "humor": 0.2}, "dominant": "emotional_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "皮克一下，戴斯回来", "time_ms": 0, "mode": 1, "tags": {"humor": 0.7, "information": 0.2}, "dominant": "humor", "score": 0.7, "source": "llm-llm"}, {"text": "不疼", "time_ms": 0, "mode": 1, "tags": {"humor": 0.3, "emotional_resonance": 0.2}, "dominant": "humor", "score": 0.3, "source": "llm-llm"}, {"text": "细节四个", "time_ms": 0, "mode": 1, "tags": {"information": 0.5, "humor": 0.1}, "dominant": "information", "score": 0.5, "source": "llm-llm"}, {"text": "痛苦者退让了", "time_ms": 0, "mode": 1, "tags": {"humor": 0.55}, "dominant": "humor", "score": 0.55, "source": "llm-llm"}, {"text": "众宾欢也", "tim