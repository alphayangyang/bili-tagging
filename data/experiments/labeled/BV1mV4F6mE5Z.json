_resonance", "score": 0.5, "source": "llm-llm"}, {"text": "架水桶", "time_ms": 0, "mode": 1, "tags": {"information": 0.45}, "dominant": "information", "score": 0.45, "source": "llm-llm"}, {"text": "很开心啊鸭区", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.4, "humor": 0.2}, "dominant": "emotional_resonance", "score": 0.4, "source": "llm-llm"}, {"text": "齐齐哈尔", "time_ms": 0, "mode": 1, "tags": {"other": 0.5}, "dominant": "other", "score": 0.5, "source": "llm-llm"}, {"text": "还有二桃杀三士", "time_ms": 0, "mode": 1, "tags": {"humor": 0.6, "information": 0.2}, "dominant": "humor", "score": 0.6, "source": "llm-llm"}, {"text": "哦对了", "time_ms": 0, "mode": 1, "tags": {"irrelevant_repetition": 0.35}, "dominant": "irrelevant_repetition", "score": 0.35, "source": "llm-llm"}, {"text": "这谁绷得住", "time_ms": 0, "mode": 1, "tags": {"emotional_resonance": 0.6}, "dominant": "emotional_resonance", "score": 0.6, "source": "llm-llm"}, {"text": "二桃杀三士", "time_ms": 0, "mode": 1, "tags": {"humor": 0.55, "information": 0.2}, "dominant": "humor", "score": 0.55, "source": "llm-llm"}, {"text": "念辣个", "time_ms": 0, "mode": 1, "tags": {"other": 0.4}, "dominant": "other", "score": 0.4, "source": "llm-llm"}, {"text": "一酒杀二士", "time_ms": 0, "mode": 1, "tags": {"humor": 0.8}, "dominant": "humor", "score": 0.8, "source": "llm-llm"}, {"text": "表露孝心", "time_ms": 0, "mode": 1, "tags": {"humor": 0.55, "attack": 0.2}, "dominant": "humor", "score": 0.55, "source": "llm-llm"}, {"text": "《啊》", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "emotional_resonance": 0.2}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "这露娜声音有点像天皇", "time_ms": 0, "mode": 1, "tags": {"humor": 0.4, "political": 0.15}, "dominant": "humor", "score": 0.4, "source": "llm-llm"}, {"text": "一酒杀两人", "time_ms": 0, "mode": 1, "tags": {"humor": 0.8}, "dominant": "humor", "score": 0.8, "source": "llm-llm"}, {"text": "还有一酒害二贤", "time_ms": 0, "mode": 1, "tags": {"humor": 0.8}, "dominant": "humor", "score": 0.8, "source": "ll